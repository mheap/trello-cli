#!/usr/bin/env node

const { execute } = require('@oclif/core')

const path = require('path')
const project = path.join(__dirname, '..', 'tsconfig.json')

// In dev mode -> use ts-node and dev plugins
process.env.NODE_ENV = 'development'

require('ts-node').register({project})
// The interactive UI uses ESM, including Ink's asynchronous module graph.
process.env.TS_NODE_PROJECT = project
require('node:module').register('ts-node/esm', require('node:url').pathToFileURL(__filename))

// Start the CLI
execute({ development: true, dir: __dirname })
