{
  "name": "trello-cli",
  "version": "1.7.0",
  "description": "Access your Trello account using the CLI",
  "author": "Michael Heap <m@michaelheap.com>",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "trello": "./bin/run"
  },
  "homepage": "https://github.com/mheap/trello-cli",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": "mheap/trello-cli",
  "files": [
    "/bin",
    "/dist",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@oclif/core": "4.8.0",
    "@oclif/plugin-autocomplete": "^3.3.0",
    "@oclif/plugin-help": "^6.3.0",
    "@oclif/plugin-plugins": "^5.5.2",
    "@trello-cli/cache": "workspace:*",
    "@trello-cli/config": "workspace:*",
    "chai": "^6.2.2",
    "chrono-node": "^2.10.1",
    "ink": "3.2.0",
    "ink-select-input": "4.2.2",
    "ink-spinner": "4.0.3",
    "ink-text-input": "4.0.3",
    "json2csv": "6.0.0-alpha.2",
    "react": "17.0.2",
    "trello.js": "^1.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@oclif/test": "4.1.16",
    "@types/jest": "^30.0.0",
    "@types/json2csv": "^5.0.7",
    "@types/node": "^26.4.1",
    "@types/react": "17.0.91",
    "eslint": "^9.39.5",
    "ink-testing-library": "2.1.0",
    "oclif": "^4.24.0",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "oclif": {
    "bin": "trello",
    "dirname": "trello-cli",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins",
      "@oclif/plugin-autocomplete"
    ],
    "topicSeparator": ":",
    "topics": {}
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "dev": "tsc -b --watch",
    "lint": "eslint src test",
    "posttest": "pnpm lint",
    "prepack": "pnpm build && oclif manifest && oclif readme",
    "test": "jest --runInBand",
    "version": "oclif readme && git add README.md"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": "https://github.com/mheap/trello-cli/issues",
  "keywords": [
    "oclif"
  ],
  "types": "dist/index.d.ts"
}
